# ────────────────────────────────────────────────────────────────────────────
# Taipei-City-Dashboard handoff env.example
# Copy to docker/.env (and Taipei-City-Dashboard-FE/.env if running FE locally),
# fill in the placeholders.
# ────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL: dashboard DB ───
DB_DASHBOARD_HOST=postgres-data
DB_DASHBOARD_PORT=5432
DB_DASHBOARD_USER=postgres
DB_DASHBOARD_PASSWORD=CHANGE_ME
DB_DASHBOARD_DBNAME=dashboarddb

# ─── PostgreSQL: dashboard-manager DB (auth / users) ───
DB_MANAGER_HOST=postgres-manager
DB_MANAGER_PORT=5432
DB_MANAGER_USER=postgres
DB_MANAGER_PASSWORD=CHANGE_ME
DB_MANAGER_DBNAME=dashboardmanagerdb

# ─── Redis (rate limit / session) ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Qdrant (vector DB for RAG) ───
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=gogosecurity
QDRANT_COLLECTION=query_charts        # 既有元件 chart 用,可不動
QDRANT_DOC_COLLECTION=documents       # AI 文件問答用 (md_files/ 灌進這裡)

# ─── TWCC (LLM 推論) ───
# 從台灣 AI Cloud (TWCC) 拿 API key
TWCC_API_URL=https://...
TWCC_API_KEY=CHANGE_ME
TWCC_MODEL=meta-llama/Llama-3.3-70B-Instruct
TWCC_TIMEOUT=60
TWCC_MAX_RETRY=2
TWCC_MAX_CONCURRENT=4

# ─── Mapbox (BE 路徑/geocode + FE 地圖) ───
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.CHANGE_ME
VITE_MAPBOXTOKEN=pk.CHANGE_ME
VITE_MAPBOXTILE=mapbox://styles/...

# ─── Gin / JWT / 其他 ───
GIN_MODE=debug
GIN_DOMAIN=localhost
GIN_PORT=8080
JWT_SECRET=CHANGE_ME_long_random_string
IDNO_SALT=CHANGE_ME_random_salt

# ─── 北市通 SSO (可選, 開發不一定要) ───
ISSO_CLIENT_ID=
ISSO_CLIENT_SECRET=
ISSO_CLIENT_SCOPE=
TAIPEIPASS_URL=

# ─── FE Vite 設定 ───
NODE_ENV=development
VITE_API_URL=http://localhost:8088/api/v1
VITE_APP_TITLE=Taipei City Dashboard
VITE_APP_VERSION=1.0.0

# ─── 其他 ───
NGINX_IMAGE_TAG=latest
NODE_IMAGE_TAG=20
GOLANG_IMAGE_TAG=1.22
LM_MODEL_PATH=
